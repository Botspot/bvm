+static int
+bvm_caps_shim_enabled(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("NPT_CAPS_SHIM") != NULL;
+   return on;
+}
+
+static HRESULT
+bvm_ID3D11Device_CheckFormatSupport(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device_CheckFormatSupport *args,
+   PFN_ID3D11Device_CheckFormatSupport original)
+{
+   HRESULT hr = original(args->_self, args->Format, args->pFormatSupport);
+   if (bvm_caps_shim_enabled() && hr == 0 && args->pFormatSupport) {
+      for (unsigned i = 0; i < ARRAY_SIZE(bvm_fmt_floor); i++) {
+         if (bvm_fmt_floor[i].fmt == (unsigned)args->Format) {
+            *args->pFormatSupport |= bvm_fmt_floor[i].mask;
+            break;
+         }
+      }
+   }
+   return hr;
+}
+
+static HRESULT
+bvm_ID3D11Device_CheckFeatureSupport(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device_CheckFeatureSupport *args,
+   PFN_ID3D11Device_CheckFeatureSupport original)
+{
+   HRESULT hr = original(args->_self, args->Feature, args->pFeatureSupportData, args->FeatureSupportDataSize);
+   if (!bvm_caps_shim_enabled() || !args->pFeatureSupportData)
+      return hr;
+
+   uint32_t *d = (uint32_t *)args->pFeatureSupportData;
+   const unsigned size = args->FeatureSupportDataSize;
+   switch ((int)args->Feature) {
+   case 1: /* D3D11_FEATURE_DOUBLES: DoublePrecisionFloatShaderOps */
+      if (hr == 0 && size >= 4)
+         d[0] = 1;
+      break;
+   case 3: /* D3D11_FEATURE_FORMAT_SUPPORT2: { InFormat, OutFormatSupport2 } */
+      if (size >= 8) {
+         for (unsigned i = 0; i < ARRAY_SIZE(bvm_sup2); i++) {
+            if (bvm_sup2[i].fmt == d[0]) {
+               if (!bvm_sup2[i].fail) {
+                  d[1] |= bvm_sup2[i].val;
+                  hr = 0;
+               }
+               break;
+            }
+         }
+      }
+      break;
+   case 8: /* D3D11_FEATURE_SHADER_MIN_PRECISION_SUPPORT: 2 = 16-bit */
+      if (hr == 0 && size >= 8) {
+         d[0] = 2;
+         d[1] = 2;
+      }
+      break;
+   case 14: /* D3D11_FEATURE_D3D11_OPTIONS2: PSSpecifiedStencilRefSupported */
+      if (hr == 0 && size >= 4)
+         d[0] = 1;
+      break;
+   case 15: /* D3D11_FEATURE_D3D11_OPTIONS3: VPAndRTArrayIndexFromAnyShaderFeedingRasterizer */
+      if (hr == 0 && size >= 4)
+         d[0] = 1;
+      break;
+   default:
+      break;
+   }
+   return hr;
+}
