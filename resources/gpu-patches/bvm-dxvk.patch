 namespace dxvk {
 
+  // V3D is a tiler: DiscardView becomes loadOp DONT_CARE and tiles the following
+  // partial redraw does not cover are lost, but D2D/XAML/DComp rely on the rest of
+  // the target surviving a discard (desktop GPUs keep it). Ignore discards of color
+  // targets by default; depth/stencil and buffer discards are unchanged.
+  // BVM_DXVK_KEEPDISCARD=1 restores upstream behavior, BVM_DXVK_NODISCARD=1 also
+  // ignores depth/stencil discards.
+  static bool bvmEnvFlag(const char* name) {
+    const char* e = getenv(name);
+    return e && *e && *e != '0';
+  }
