diff --git a/src/dxvk/dxvk_tessemu.cpp b/src/dxvk/dxvk_tessemu.cpp
new file mode 100644
index 00000000..0c785471
--- /dev/null
+++ b/src/dxvk/dxvk_tessemu.cpp
@@ -0,0 +1,1481 @@
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <set>
+#include <unistd.h>
+
+#include "dxvk_shader_spirv.h"
+#include "dxvk_tessemu.h"
+
+#include "../spirv/spirv_include.h"
+#include "../util/log/log.h"
+#include "../util/util_string.h"
+
+namespace dxvk {
+
+  namespace {
+
+    // ------------------------------------------------------------------
+    // Minimal SPIR-V reader / writer for the domain shader's output
+    // interface. Only what is needed to capture the outputs with
+    // transform feedback and to replay them from a vertex shader.
+    // ------------------------------------------------------------------
+
+    struct SpvType {
+      uint32_t op = 0u;
+      uint32_t a = 0u;
+      uint32_t b = 0u;
+    };
+
+    struct OutVar {
+      uint32_t id = 0u;
+      uint32_t kind = 0u;       // 0 float, 1 sint, 2 uint
+      uint32_t comps = 1u;      // components per element
+      uint32_t elems = 1u;      // array length, or 1
+      bool     isArray = false;
+      bool     builtIn = false;
+      uint32_t builtInId = 0u;
+      bool     hasLocation = false;
+      uint32_t location = 0u;
+      bool     hasComponent = false;
+      uint32_t component = 0u;
+      bool     flat = false;
+      bool     noPerspective = false;
+      bool     centroid = false;
+      bool     sample = false;
+      uint32_t xfbOffset = 0u;
+    };
+
+    constexpr uint32_t OpCodeMask = 0xffffu;
+
+    bool isPreTypeOpcode(uint32_t op) {
+      switch (op) {
+        case spv::OpCapability:
+        case spv::OpExtension:
+        case spv::OpExtInstImport:
+        case spv::OpMemoryModel:
+        case spv::OpEntryPoint:
+        case spv::OpExecutionMode:
+        case spv::OpExecutionModeId:
+        case spv::OpString:
+        case spv::OpSource:
+        case spv::OpSourceExtension:
+        case spv::OpSourceContinued:
+        case spv::OpName:
+        case spv::OpMemberName:
+        case spv::OpModuleProcessed:
+        case spv::OpLine:
+        case spv::OpNoLine:
+        case spv::OpDecorate:
+        case spv::OpMemberDecorate:
+        case spv::OpDecorationGroup:
+        case spv::OpGroupDecorate:
+        case spv::OpGroupMemberDecorate:
+        case spv::OpDecorateId:
+        case spv::OpDecorateString:
+        case spv::OpMemberDecorateString:
+          return true;
+        default:
+          return false;
+      }
+    }
+
+    bool isHeaderOpcode(uint32_t op) {
+      switch (op) {
+        case spv::OpCapability:
+        case spv::OpExtension:
+        case spv::OpExtInstImport:
+        case spv::OpMemoryModel:
+        case spv::OpEntryPoint:
+        case spv::OpExecutionMode:
+        case spv::OpExecutionModeId:
+          return true;
+        default:
+          return false;
+      }
+    }
+
+
+    bool analyzeOutputs(
+      const uint32_t*       code,
+            size_t          words,
+            std::vector<OutVar>& result,
+            uint32_t&       entryId,
+            std::string&    why) {
+      std::unordered_map<uint32_t, SpvType> types;
+      std::unordered_map<uint32_t, uint32_t> constants;
+      std::unordered_map<uint32_t, std::vector<std::array<uint32_t, 3>>> decorations;
+      std::vector<std::pair<uint32_t, uint32_t>> outputs;   // (variable id, pointer type id)
+      entryId = 0u;
+
+      size_t i = 5u;
+
+      while (i < words) {
+        uint32_t len = code[i] >> 16u;
+        uint32_t op = code[i] & OpCodeMask;
+
+        if (!len || i + len > words) {
+          why = "malformed SPIR-V";
+          return false;
+        }
+
+        const uint32_t* o = &code[i + 1u];
+
+        switch (op) {
+          case spv::OpEntryPoint:
+            if (!entryId)
+              entryId = o[1];
+            break;
+
+          case spv::OpTypeInt:
+            types[o[0]] = { op, o[1], o[2] };
+            break;
+
+          case spv::OpTypeFloat:
+            types[o[0]] = { op, o[1], 0u };
+            break;
+
+          case spv::OpTypeVector:
+            types[o[0]] = { op, o[1], o[2] };
+            break;
+
+          case spv::OpTypeArray:
+            types[o[0]] = { op, o[1], o[2] };
+            break;
+
+          case spv::OpTypePointer:
+            types[o[0]] = { op, o[1], o[2] };
+            break;
+
+          case spv::OpTypeStruct:
+          case spv::OpTypeMatrix:
+          case spv::OpTypeBool:
+            types[o[0]] = { op, 0u, 0u };
+            break;
+
+          case spv::OpConstant:
+            if (len >= 4u)
+              constants[o[1]] = o[2];
+            break;
+
+          case spv::OpDecorate: {
+            std::array<uint32_t, 3> d = { o[1], len > 3u ? o[2] : 0u, 0u };
+            decorations[o[0]].push_back(d);
+          } break;
+
+          case spv::OpVariable:
+            if (o[2] == spv::StorageClassOutput)
+              outputs.emplace_back(o[1], o[0]);
+            break;
+
+          default:
+            break;
+        }
+
+        i += len;
+      }
+
+      for (auto [id, ptrType] : outputs) {
+        OutVar v = { };
+        v.id = id;
+
+        auto ptr = types.find(ptrType);
+
+        if (ptr == types.end() || ptr->second.op != spv::OpTypePointer) {
+          why = "output variable without pointer type";
+          return false;
+        }
+
+        uint32_t t = ptr->second.b;
+
+        auto at = types.find(t);
+
+        if (at != types.end() && at->second.op == spv::OpTypeArray) {
+          auto len = constants.find(at->second.b);
+
+          if (len == constants.end()) {
+            why = "output array with non-constant length";
+            return false;
+          }
+
+          v.isArray = true;
+          v.elems = len->second;
+          t = at->second.a;
+          at = types.find(t);
+        }
+
+        if (at != types.end() && at->second.op == spv::OpTypeVector) {
+          v.comps = at->second.b;
+          t = at->second.a;
+          at = types.find(t);
+        }
+
+        if (at == types.end()) {
+          why = "unknown output element type";
+          return false;
+        }
+
+        if (at->second.op == spv::OpTypeFloat && at->second.a == 32u) {
+          v.kind = 0u;
+        } else if (at->second.op == spv::OpTypeInt && at->second.a == 32u) {
+          v.kind = at->second.b ? 1u : 2u;
+        } else {
+          why = str::format("unsupported output element type (op ", at->second.op, ")");
+          return false;
+        }
+
+        if (v.comps < 1u || v.comps > 4u || !v.elems) {
+          why = "unsupported output shape";
+          return false;
+        }
+
+        auto deco = decorations.find(id);
+
+        if (deco != decorations.end()) {
+          for (const auto& d : deco->second) {
+            switch (d[0]) {
+              case spv::DecorationBuiltIn:
+                v.builtIn = true;
+                v.builtInId = d[1];
+                break;
+              case spv::DecorationLocation:
+                v.hasLocation = true;
+                v.location = d[1];
+                break;
+              case spv::DecorationComponent:
+                v.hasComponent = true;
+                v.component = d[1];
+                break;
+              case spv::DecorationFlat:          v.flat = true; break;
+              case spv::DecorationNoPerspective: v.noPerspective = true; break;
+              case spv::DecorationCentroid:      v.centroid = true; break;
+              case spv::DecorationSample:        v.sample = true; break;
+              case spv::DecorationPatch:
+                why = "patch output in tessellation evaluation shader";
+                return false;
+              default:
+                break;
+            }
+          }
+        }
+
+        if (!v.builtIn && !v.hasLocation) {
+          why = "output without location or built-in";
+          return false;
+        }
+
+        if (v.builtIn && v.builtInId != spv::BuiltInPosition
+         && v.builtInId != spv::BuiltInClipDistance
+         && v.builtInId != spv::BuiltInCullDistance
+         && v.builtInId != spv::BuiltInPointSize) {
+          why = str::format("unsupported built-in output ", v.builtInId);
+          return false;
+        }
+
+        result.push_back(v);
+      }
+
+      if (!entryId || result.empty()) {
+        why = "no entry point or no outputs";
+        return false;
+      }
+
+      return true;
+    }
+
+
+    VkFormat getVertexFormat(uint32_t kind, uint32_t comps) {
+      static const VkFormat formats[3][4] = {
+        { VK_FORMAT_R32_SFLOAT, VK_FORMAT_R32G32_SFLOAT, VK_FORMAT_R32G32B32_SFLOAT, VK_FORMAT_R32G32B32A32_SFLOAT },
+        { VK_FORMAT_R32_SINT,   VK_FORMAT_R32G32_SINT,   VK_FORMAT_R32G32B32_SINT,   VK_FORMAT_R32G32B32A32_SINT },
+        { VK_FORMAT_R32_UINT,   VK_FORMAT_R32G32_UINT,   VK_FORMAT_R32G32B32_UINT,   VK_FORMAT_R32G32B32A32_UINT },
+      };
+
+      return formats[kind][comps - 1u];
+    }
+
+
+    // Adds transform feedback capture of every output to the domain shader
+    std::vector<uint32_t> injectXfb(
+      const uint32_t*       code,
+            size_t          words,
+            uint32_t        entryId,
+      const std::vector<OutVar>& outs,
+            uint32_t        stride) {
+      std::vector<uint32_t> result;
+      result.reserve(words + 8u + outs.size() * 12u);
+      result.insert(result.end(), code, code + 5u);
+
+      // Capability TransformFeedback may go anywhere in the capability list
+      result.push_back((2u << 16u) | spv::OpCapability);
+      result.push_back(spv::CapabilityTransformFeedback);
+
+      bool wroteMode = false;
+      bool wroteDeco = false;
+      size_t i = 5u;
+
+      while (i < words) {
+        uint32_t len = code[i] >> 16u;
+        uint32_t op = code[i] & OpCodeMask;
+
+        if (!wroteMode && !isHeaderOpcode(op)) {
+          result.push_back((3u << 16u) | spv::OpExecutionMode);
+          result.push_back(entryId);
+          result.push_back(spv::ExecutionModeXfb);
+          wroteMode = true;
+        }
+
+        if (!wroteDeco && !isPreTypeOpcode(op)) {
+          for (const auto& v : outs) {
+            result.push_back((4u << 16u) | spv::OpDecorate);
+            result.push_back(v.id);
+            result.push_back(spv::DecorationXfbBuffer);
+            result.push_back(0u);
+
+            result.push_back((4u << 16u) | spv::OpDecorate);
+            result.push_back(v.id);
+            result.push_back(spv::DecorationXfbStride);
+            result.push_back(stride);
+
+            result.push_back((4u << 16u) | spv::OpDecorate);
+            result.push_back(v.id);
+            result.push_back(spv::DecorationOffset);
+            result.push_back(v.xfbOffset);
+          }
+
+          wroteDeco = true;
+        }
+
+        result.insert(result.end(), code + i, code + i + len);
+        i += len;
+      }
+
+      return result;
+    }
+
+
+    // Generates a vertex shader that replays the captured vertices: every
+    // scalar/vector element of every domain shader output becomes a vertex
+    // attribute, and is written to an output with the original decorations.
+    class PassthroughBuilder {
+
+    public:
+
+      std::vector<uint32_t> build(
+        const std::vector<OutVar>&                outs,
+              std::vector<DxvkTessEmuLayout::Attribute>& attributes) {
+        bool needClip = false;
+        bool needCull = false;
+
+        for (const auto& v : outs) {
+          needClip |= v.builtIn && v.builtInId == spv::BuiltInClipDistance;
+          needCull |= v.builtIn && v.builtInId == spv::BuiltInCullDistance;
+        }
+
+        uint32_t voidType = newId();
+        uint32_t fnType = newId();
+        uint32_t mainId = newId();
+        uint32_t labelId = newId();
+
+        std::vector<uint32_t> ifaces;
+        std::vector<uint32_t> body;
+        uint32_t location = 0u;
+
+        struct Copy {
+          uint32_t in;
+          uint32_t out;
+          uint32_t elemType;
+          uint32_t outPtrElemType;
+          bool     isArray;
+          uint32_t index;
+        };
+
+        std::vector<Copy> copies;
+
+        for (const auto& v : outs) {
+          uint32_t elemType = vecType(v.kind, v.comps);
+          uint32_t outType = v.isArray ? arrayType(elemType, v.elems) : elemType;
+          uint32_t outVar = newId();
+          uint32_t outPtr = pointerType(spv::StorageClassOutput, outType);
+          uint32_t outPtrElem = pointerType(spv::StorageClassOutput, elemType);
+
+          m_types.push_back((4u << 16u) | spv::OpVariable);
+          m_types.push_back(outPtr);
+          m_types.push_back(outVar);
+          m_types.push_back(spv::StorageClassOutput);
+
+          ifaces.push_back(outVar);
+
+          if (v.builtIn) {
+            deco(outVar, spv::DecorationBuiltIn, v.builtInId);
+          } else {
+            deco(outVar, spv::DecorationLocation, v.location);
+
+            if (v.hasComponent)
+              deco(outVar, spv::DecorationComponent, v.component);
+          }
+
+          if (v.flat || (!v.builtIn && v.kind != 0u))
+            deco(outVar, spv::DecorationFlat);
+          if (v.noPerspective)
+            deco(outVar, spv::DecorationNoPerspective);
+          if (v.centroid)
+            deco(outVar, spv::DecorationCentroid);
+          if (v.sample)
+            deco(outVar, spv::DecorationSample);
+
+          for (uint32_t e = 0u; e < v.elems; e++) {
+            uint32_t inVar = newId();
+            uint32_t inPtr = pointerType(spv::StorageClassInput, elemType);
+
+            m_types.push_back((4u << 16u) | spv::OpVariable);
+            m_types.push_back(inPtr);
+            m_types.push_back(inVar);
+            m_types.push_back(spv::StorageClassInput);
+
+            ifaces.push_back(inVar);
+            deco(inVar, spv::DecorationLocation, location);
+
+            DxvkTessEmuLayout::Attribute attr = { };
+            attr.location = location;
+            attr.format = getVertexFormat(v.kind, v.comps);
+            attr.offset = v.xfbOffset + e * v.comps * 4u;
+            attributes.push_back(attr);
+
+            location++;
+
+            copies.push_back({ inVar, outVar, elemType, outPtrElem, v.isArray, e });
+          }
+        }
+
+        // Function body
+        for (const auto& c : copies) {
+          uint32_t value = newId();
+          body.push_back((4u << 16u) | spv::OpLoad);
+          body.push_back(c.elemType);
+          body.push_back(value);
+          body.push_back(c.in);
+
+          uint32_t target = c.out;
+
+          if (c.isArray) {
+            uint32_t chain = newId();
+            body.push_back((5u << 16u) | spv::OpAccessChain);
+            body.push_back(c.outPtrElemType);
+            body.push_back(chain);
+            body.push_back(c.out);
+            body.push_back(uintConstant(c.index));
+            target = chain;
+          }
+
+          body.push_back((3u << 16u) | spv::OpStore);
+          body.push_back(target);
+          body.push_back(value);
+        }
+
+        // Assemble the module
+        std::vector<uint32_t> out;
+        out.push_back(spv::MagicNumber);
+        out.push_back(0x00010300u);
+        out.push_back(0u);
+        out.push_back(0u);   // bound, patched below
+        out.push_back(0u);
+
+        auto inst = [&] (uint32_t op, std::initializer_list<uint32_t> operands) {
+          out.push_back((uint32_t(operands.size() + 1u) << 16u) | op);
+          out.insert(out.end(), operands.begin(), operands.end());
+        };
+
+        inst(spv::OpCapability, { spv::CapabilityShader });
+
+        if (needClip)
+          inst(spv::OpCapability, { spv::CapabilityClipDistance });
+        if (needCull)
+          inst(spv::OpCapability, { spv::CapabilityCullDistance });
+
+        inst(spv::OpMemoryModel, { spv::AddressingModelLogical, spv::MemoryModelGLSL450 });
+
+        out.push_back(((5u + uint32_t(ifaces.size())) << 16u) | spv::OpEntryPoint);
+        out.push_back(spv::ExecutionModelVertex);
+        out.push_back(mainId);
+        out.push_back(0x6e69616du);  // "main"
+        out.push_back(0u);
+        out.insert(out.end(), ifaces.begin(), ifaces.end());
+
+        out.insert(out.end(), m_decorations.begin(), m_decorations.end());
+
+        inst(spv::OpTypeVoid, { voidType });
+        inst(spv::OpTypeFunction, { fnType, voidType });
+        out.insert(out.end(), m_scalarTypes.begin(), m_scalarTypes.end());
+        out.insert(out.end(), m_constants.begin(), m_constants.end());
+        out.insert(out.end(), m_derivedTypes.begin(), m_derivedTypes.end());
+        out.insert(out.end(), m_types.begin(), m_types.end());
+
+        inst(spv::OpFunction, { voidType, mainId, spv::FunctionControlMaskNone, fnType });
+        inst(spv::OpLabel, { labelId });
+        out.insert(out.end(), body.begin(), body.end());
+        inst(spv::OpReturn, { });
+        inst(spv::OpFunctionEnd, { });
+
+        out[3] = m_nextId;
+        return out;
+      }
+
+    private:
+
+      uint32_t m_nextId = 1u;
+
+      std::vector<uint32_t> m_decorations;
+      std::vector<uint32_t> m_scalarTypes;
+      std::vector<uint32_t> m_constants;
+      std::vector<uint32_t> m_derivedTypes;
+      std::vector<uint32_t> m_types;       // pointer types and variables
+
+      std::map<uint32_t, uint32_t> m_scalarIds;
+      std::map<std::pair<uint32_t, uint32_t>, uint32_t> m_vecIds;
+      std::map<std::pair<uint32_t, uint32_t>, uint32_t> m_arrayIds;
+      std::map<std::pair<uint32_t, uint32_t>, uint32_t> m_ptrIds;
+      std::map<uint32_t, uint32_t> m_uintConstants;
+
+      uint32_t newId() {
+        return m_nextId++;
+      }
+
+      void deco(uint32_t id, uint32_t decoration) {
+        m_decorations.push_back((3u << 16u) | spv::OpDecorate);
+        m_decorations.push_back(id);
+        m_decorations.push_back(decoration);
+      }
+
+      void deco(uint32_t id, uint32_t decoration, uint32_t value) {
+        m_decorations.push_back((4u << 16u) | spv::OpDecorate);
+        m_decorations.push_back(id);
+        m_decorations.push_back(decoration);
+        m_decorations.push_back(value);
+      }
+
+      uint32_t scalarType(uint32_t kind) {
+        auto entry = m_scalarIds.find(kind);
+
+        if (entry != m_scalarIds.end())
+          return entry->second;
+
+        uint32_t id = newId();
+
+        if (kind == 0u) {
+          m_scalarTypes.push_back((3u << 16u) | spv::OpTypeFloat);
+          m_scalarTypes.push_back(id);
+          m_scalarTypes.push_back(32u);
+        } else {
+          m_scalarTypes.push_back((4u << 16u) | spv::OpTypeInt);
+          m_scalarTypes.push_back(id);
+          m_scalarTypes.push_back(32u);
+          m_scalarTypes.push_back(kind == 1u ? 1u : 0u);
+        }
+
+        m_scalarIds.insert({ kind, id });
+        return id;
+      }
+
+      uint32_t uintConstant(uint32_t value) {
+        auto entry = m_uintConstants.find(value);
+
+        if (entry != m_uintConstants.end())
+          return entry->second;
+
+        uint32_t type = scalarType(2u);
+        uint32_t id = newId();
+
+        m_constants.push_back((4u << 16u) | spv::OpConstant);
+        m_constants.push_back(type);
+        m_constants.push_back(id);
+        m_constants.push_back(value);
+
+        m_uintConstants.insert({ value, id });
+        return id;
+      }
+
+      uint32_t vecType(uint32_t kind, uint32_t comps) {
+        uint32_t scalar = scalarType(kind);
+
+        if (comps == 1u)
+          return scalar;
+
+        auto key = std::make_pair(kind, comps);
+        auto entry = m_vecIds.find(key);
+
+        if (entry != m_vecIds.end())
+          return entry->second;
+
+        uint32_t id = newId();
+
+        m_derivedTypes.push_back((4u << 16u) | spv::OpTypeVector);
+        m_derivedTypes.push_back(id);
+        m_derivedTypes.push_back(scalar);
+        m_derivedTypes.push_back(comps);
+
+        m_vecIds.insert({ key, id });
+        return id;
+      }
+
+      uint32_t arrayType(uint32_t elem, uint32_t length) {
+        auto key = std::make_pair(elem, length);
+        auto entry = m_arrayIds.find(key);
+
+        if (entry != m_arrayIds.end())
+          return entry->second;
+
+        uint32_t lengthId = uintConstant(length);
+        uint32_t id = newId();
+
+        m_derivedTypes.push_back((4u << 16u) | spv::OpTypeArray);
+        m_derivedTypes.push_back(id);
+        m_derivedTypes.push_back(elem);
+        m_derivedTypes.push_back(lengthId);
+
+        m_arrayIds.insert({ key, id });
+        return id;
+      }
+
+      uint32_t pointerType(uint32_t storage, uint32_t pointee) {
+        auto key = std::make_pair(storage, pointee);
+        auto entry = m_ptrIds.find(key);
+
+        if (entry != m_ptrIds.end())
+          return entry->second;
+
+        uint32_t id = newId();
+
+        m_derivedTypes.push_back((4u << 16u) | spv::OpTypePointer);
+        m_derivedTypes.push_back(id);
+        m_derivedTypes.push_back(storage);
+        m_derivedTypes.push_back(pointee);
+
+        m_ptrIds.insert({ key, id });
+        return id;
+      }
+
+    };
+
+
+    uint32_t findMemoryType(const VkPhysicalDeviceMemoryProperties& props, uint32_t bits, VkMemoryPropertyFlags want) {
+      for (uint32_t i = 0u; i < props.memoryTypeCount; i++) {
+        if ((bits & (1u << i)) && (props.memoryTypes[i].propertyFlags & want) == want)
+          return i;
+      }
+
+      return ~0u;
+    }
+
+    constexpr VkDeviceSize alignUp(VkDeviceSize v, VkDeviceSize a) {
+      return (v + a - 1u) & ~(a - 1u);
+    }
+
+  }
