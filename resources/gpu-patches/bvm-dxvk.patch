+
+  bool DxvkTessEmu::init() {
+    m_vkl = new vk::LibraryFn();
+
+    if (!m_vkl->getLoaderProc()) {
+      Logger::err("BVMTESS: no Vulkan loader");
+      return false;
+    }
+
+    // Find the lavapipe ICD
+    std::string icd;
+
+    if (const char* e = std::getenv("BVM_TESSEMU_ICD"))
+      icd = e;
+
+    if (icd.empty()) {
+      static const char* candidates[] = {
+        "/usr/share/vulkan/icd.d/lvp_icd.aarch64.json",
+        "/usr/share/vulkan/icd.d/lvp_icd.json",
+        "/usr/local/share/vulkan/icd.d/lvp_icd.json",
+      };
+
+      for (auto c : candidates) {
+        if (!access(c, R_OK)) {
+          icd = c;
+          break;
+        }
+      }
+    }
+
+    if (icd.empty()) {
+      Logger::err("BVMTESS: lavapipe ICD json not found (set BVM_TESSEMU_ICD)");
+      return false;
+    }
+
+    // The loader reads the driver list when the instance is created, so point
+    // it at lavapipe only for this call.
+    const char* oldDrivers = std::getenv("VK_DRIVER_FILES");
+    std::string oldDriversCopy = oldDrivers ? oldDrivers : "";
+    const char* oldIcd = std::getenv("VK_ICD_FILENAMES");
+    std::string oldIcdCopy = oldIcd ? oldIcd : "";
+
+    setenv("VK_DRIVER_FILES", icd.c_str(), 1);
+    unsetenv("VK_ICD_FILENAMES");
+
+    VkApplicationInfo appInfo = { VK_STRUCTURE_TYPE_APPLICATION_INFO };
+    appInfo.pApplicationName = "dxvk-tessemu";
+    appInfo.apiVersion = VK_API_VERSION_1_3;
+
+    VkInstanceCreateInfo instInfo = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+    instInfo.pApplicationInfo = &appInfo;
+
+    VkResult vr = m_vkl->vkCreateInstance(&instInfo, nullptr, &m_instance);
+
+    if (oldDrivers)
+      setenv("VK_DRIVER_FILES", oldDriversCopy.c_str(), 1);
+    else
+      unsetenv("VK_DRIVER_FILES");
+
+    if (oldIcd)
+      setenv("VK_ICD_FILENAMES", oldIcdCopy.c_str(), 1);
+
+    if (vr != VK_SUCCESS) {
+      Logger::err(str::format("BVMTESS: vkCreateInstance failed: ", vr));
+      return false;
+    }
+
+    m_vki = new vk::InstanceFn(m_vkl, false, m_instance);
+
+    uint32_t count = 0u;
+    m_vki->vkEnumeratePhysicalDevices(m_instance, &count, nullptr);
+    std::vector<VkPhysicalDevice> devices(count);
+    m_vki->vkEnumeratePhysicalDevices(m_instance, &count, devices.data());
+
+    for (auto d : devices) {
+      VkPhysicalDeviceProperties props = { };
+      m_vki->vkGetPhysicalDeviceProperties(d, &props);
+
+      Logger::warn(str::format("BVMTESS: candidate device ", props.deviceName, " type ", uint32_t(props.deviceType)));
+
+      if (props.deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU) {
+        m_physical = d;
+        m_uboAlign = std::max<VkDeviceSize>(props.limits.minUniformBufferOffsetAlignment, 256u);
+        Logger::warn(str::format("BVMTESS: using ", props.deviceName));
+        break;
+      }
+    }
+
+    if (!m_physical) {
+      Logger::err("BVMTESS: no CPU (lavapipe) Vulkan device visible; the loader may have ignored VK_DRIVER_FILES");
+      return false;
+    }
+
+    m_vki->vkGetPhysicalDeviceMemoryProperties(m_physical, &m_memory);
+
+    VkPhysicalDeviceTransformFeedbackFeaturesEXT xfb = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TRANSFORM_FEEDBACK_FEATURES_EXT };
+    VkPhysicalDeviceVulkan13Features f13 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES };
+    VkPhysicalDeviceVulkan12Features f12 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+    VkPhysicalDeviceFeatures2 f2 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+    f13.pNext = &xfb;
+    f12.pNext = &f13;
+    f2.pNext = &f12;
+
+    m_vki->vkGetPhysicalDeviceFeatures2(m_physical, &f2);
+
+    if (!f2.features.tessellationShader || !xfb.transformFeedback || !f13.dynamicRendering) {
+      Logger::err("BVMTESS: lavapipe lacks tessellation / transform feedback / dynamic rendering");
+      return false;
+    }
+
+    const char* exts[] = { VK_EXT_TRANSFORM_FEEDBACK_EXTENSION_NAME };
+    float prio = 1.0f;
+
+    VkDeviceQueueCreateInfo queueInfo = { VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+    queueInfo.queueFamilyIndex = 0u;
+    queueInfo.queueCount = 1u;
+    queueInfo.pQueuePriorities = &prio;
+
+    VkDeviceCreateInfo devInfo = { VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO };
+    devInfo.pNext = &f2;
+    devInfo.queueCreateInfoCount = 1u;
+    devInfo.pQueueCreateInfos = &queueInfo;
+    devInfo.enabledExtensionCount = 1u;
+    devInfo.ppEnabledExtensionNames = exts;
+
+    vr = m_vki->vkCreateDevice(m_physical, &devInfo, nullptr, &m_device);
+
+    if (vr != VK_SUCCESS) {
+      Logger::err(str::format("BVMTESS: vkCreateDevice failed: ", vr));
+      return false;
+    }
+
+    m_vkd = new vk::DeviceFn(m_vki, false, m_device);
+    m_vkd->vkGetDeviceQueue(m_device, 0u, 0u, &m_queue);
+
+    VkCommandPoolCreateInfo poolInfo = { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    poolInfo.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    poolInfo.queueFamilyIndex = 0u;
+
+    if (m_vkd->vkCreateCommandPool(m_device, &poolInfo, nullptr, &m_cmdPool) != VK_SUCCESS)
+      return false;
+
+    VkCommandBufferAllocateInfo cmdInfo = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    cmdInfo.commandPool = m_cmdPool;
+    cmdInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cmdInfo.commandBufferCount = 1u;
+
+    if (m_vkd->vkAllocateCommandBuffers(m_device, &cmdInfo, &m_cmd) != VK_SUCCESS)
+      return false;
+
+    std::array<VkDescriptorPoolSize, 2> poolSizes = {{
+      { VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 64u },
+      { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 64u },
+    }};
+
+    VkDescriptorPoolCreateInfo descPoolInfo = { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+    descPoolInfo.maxSets = 4u;
+    descPoolInfo.poolSizeCount = poolSizes.size();
+    descPoolInfo.pPoolSizes = poolSizes.data();
+
+    if (m_vkd->vkCreateDescriptorPool(m_device, &descPoolInfo, nullptr, &m_descPool) != VK_SUCCESS)
+      return false;
+
+    return true;
+  }
