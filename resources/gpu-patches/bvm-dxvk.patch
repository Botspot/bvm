+  // Number of non-zero bytes in the first part of a CPU-visible buffer range
+  static int bvmNonZero(const DxvkBuffer* buffer, VkDeviceSize offset) {
+    if (!buffer || !buffer->mapPtr(0))
+      return -1;
+
+    VkDeviceSize size = buffer->info().size;
+
+    if (offset >= size)
+      return -1;
+
+    const uint8_t* p = reinterpret_cast<const uint8_t*>(buffer->mapPtr(offset));
+    size_t n = size_t(std::min<VkDeviceSize>(size - offset, 4096u));
+    int nz = 0;
+
+    for (size_t k = 0u; k < n; k++)
+      nz += p[k] != 0;
+
+    return nz;
+  }
