+
+  bool DxvkTessEmu::ensureBuffer(VkDeviceSize size, std::string& why) {
+    if (size <= m_bufferSize)
+      return true;
+
+    if (m_buffer) {
+      m_vkd->vkUnmapMemory(m_device, m_bufferMem);
+      m_vkd->vkDestroyBuffer(m_device, m_buffer, nullptr);
+      m_vkd->vkFreeMemory(m_device, m_bufferMem, nullptr);
+      m_buffer = VK_NULL_HANDLE;
+      m_bufferMem = VK_NULL_HANDLE;
+      m_bufferSize = 0u;
+      m_bufferMap = nullptr;
+    }
+
+    VkDeviceSize newSize = std::max<VkDeviceSize>(size, 4u << 20u);
+
+    VkBufferCreateInfo info = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    info.size = newSize;
+    info.usage = VK_BUFFER_USAGE_VERTEX_BUFFER_BIT
+               | VK_BUFFER_USAGE_INDEX_BUFFER_BIT
+               | VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT
+               | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT
+               | VK_BUFFER_USAGE_TRANSFORM_FEEDBACK_BUFFER_BIT_EXT
+               | VK_BUFFER_USAGE_TRANSFORM_FEEDBACK_COUNTER_BUFFER_BIT_EXT;
+    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+
+    if (m_vkd->vkCreateBuffer(m_device, &info, nullptr, &m_buffer) != VK_SUCCESS) {
+      why = "vkCreateBuffer failed";
+      return false;
+    }
+
+    VkMemoryRequirements req = { };
+    m_vkd->vkGetBufferMemoryRequirements(m_device, m_buffer, &req);
+
+    uint32_t type = findMemoryType(m_memory, req.memoryTypeBits,
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+
+    if (type == ~0u) {
+      why = "no host-visible memory type";
+      return false;
+    }
+
+    VkMemoryAllocateInfo alloc = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    alloc.allocationSize = req.size;
+    alloc.memoryTypeIndex = type;
+
+    if (m_vkd->vkAllocateMemory(m_device, &alloc, nullptr, &m_bufferMem) != VK_SUCCESS
+     || m_vkd->vkBindBufferMemory(m_device, m_buffer, m_bufferMem, 0u) != VK_SUCCESS
+     || m_vkd->vkMapMemory(m_device, m_bufferMem, 0u, VK_WHOLE_SIZE, 0u, reinterpret_cast<void**>(&m_bufferMap)) != VK_SUCCESS) {
+      why = "buffer memory allocation failed";
+      return false;
+    }
+
+    m_bufferSize = newSize;
+    return true;
+  }
+
+
+  bool DxvkTessEmu::createPipe(Pipe& pipe, const DxvkTessEmuRequest& rq, std::string& why) {
+    // Assign emulator bindings and gather the resource layout of all stages
+    DxvkShaderBindingMap map;
+    uint32_t nextBinding = 0u;
+
+    struct StageInfo {
+      VkShaderStageFlagBits stage;
+      Rc<DxvkShader> shader;
+      const DxvkShaderLinkage* linkage;
+    };
+
+    const std::array<StageInfo, 3> stages = {{
+      { VK_SHADER_STAGE_VERTEX_BIT,                  rq.vs,  &rq.vsLinkage  },
+      { VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT,    rq.tcs, &rq.tcsLinkage },
+      { VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, rq.tes, &rq.tesLinkage },
+    }};
+
+    for (const auto& s : stages) {
+      DxvkPipelineLayoutBuilder layout = s.shader->getLayout();
+
+      if (layout.getSamplerHeapBindingCount()) {
+        why = str::format("stage ", uint32_t(s.stage), " uses samplers");
+        return false;
+      }
+
+      auto range = layout.getBindings();
+
+      for (size_t i = 0u; i < range.bindingCount; i++) {
+        const DxvkShaderDescriptor& d = range.bindings[i];
+        VkDescriptorType type = d.getDescriptorType();
+
+        if (!d.usesDescriptor()
+         || (type != VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER && type != VK_DESCRIPTOR_TYPE_STORAGE_BUFFER)) {
+          why = str::format("stage ", uint32_t(s.stage), " uses unsupported resource (type ", uint32_t(type),
+            ", set ", d.getSet(), ", binding ", d.getBinding(), ")");
+          return false;
+        }
+
+        BindingEntry entry = { };
+        entry.stage = s.stage;
+        entry.desc = d;
+        entry.type = type;
+        entry.binding = nextBinding++;
+        pipe.entries.push_back(entry);
+
+        map.addBinding(
+          DxvkShaderBinding(s.stage, d.getSet(), d.getBinding()),
+          DxvkShaderBinding(s.stage, 0u, entry.binding));
+      }
+
+      // Built-ins live at offset 0 of the shared push data block
+      map.addPushData(DxvkPushDataBlock(s.stage, 0u, 128u, 4u, 0u), 0u);
+    }
+
+    // Get the final SPIR-V
+    std::array<SpirvCodeBuffer, 3> codes = {{
+      rq.vs->getCode(&map, &rq.vsLinkage),
+      rq.tcs->getCode(&map, &rq.tcsLinkage),
+      rq.tes->getCode(&map, &rq.tesLinkage),
+    }};
+
+    // Analyze and rewrite the domain shader
+    std::vector<OutVar> outs;
+    uint32_t entryId = 0u;
+
+    if (!analyzeOutputs(codes[2].data(), codes[2].dwords(), outs, entryId, why))
+      return false;
+
+    uint32_t stride = 0u;
+
+    for (auto& v : outs) {
+      v.xfbOffset = stride;
+      stride += v.elems * v.comps * 4u;
+    }
+
+    auto layout = std::make_shared<DxvkTessEmuLayout>();
+    layout->stride = stride;
+
+    VkPrimitiveTopology topology = rq.tes->metadata().outputTopology;
+
+    if (topology == VK_PRIMITIVE_TOPOLOGY_MAX_ENUM)
+      topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+
+    if (topology != VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
+     && topology != VK_PRIMITIVE_TOPOLOGY_LINE_LIST
+     && topology != VK_PRIMITIVE_TOPOLOGY_POINT_LIST) {
+      why = str::format("unsupported tessellator output topology ", uint32_t(topology));
+      return false;
+    }
+
+    layout->topology = topology;
+
+    std::vector<uint32_t> tesXfb = injectXfb(codes[2].data(), codes[2].dwords(), entryId, outs, stride);
+
+    PassthroughBuilder builder;
+    std::vector<uint32_t> passCode = builder.build(outs, layout->attributes);
+
+    if (layout->attributes.size() > 16u) {
+      why = "too many output attributes for pass-through shader";
+      return false;
+    }
+
+    {
+      DxvkSpirvShaderCreateInfo info = { };
+      info.debugName = "bvm_tessemu_passthrough";
+      layout->passthroughVs = new DxvkSpirvShader(info, SpirvCodeBuffer(std::move(passCode)));
+    }
+
+    // Vulkan objects
+    auto makeModule = [&] (const uint32_t* code, size_t words, VkShaderModule& module) {
+      VkShaderModuleCreateInfo info = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+      info.codeSize = words * sizeof(uint32_t);
+      info.pCode = code;
+      return m_vkd->vkCreateShaderModule(m_device, &info, nullptr, &module) == VK_SUCCESS;
+    };
+
+    if (!makeModule(codes[0].data(), codes[0].dwords(), pipe.vs)
+     || !makeModule(codes[1].data(), codes[1].dwords(), pipe.tcs)
+     || !makeModule(tesXfb.data(), tesXfb.size(), pipe.tes)) {
+      why = "vkCreateShaderModule failed";
+      return false;
+    }
+
+    std::vector<VkDescriptorSetLayoutBinding> bindings;
+
+    for (const auto& e : pipe.entries) {
+      VkDescriptorSetLayoutBinding b = { };
+      b.binding = e.binding;
+      b.descriptorType = e.type;
+      b.descriptorCount = 1u;
+      b.stageFlags = VK_SHADER_STAGE_ALL_GRAPHICS;
+      bindings.push_back(b);
+    }
+
+    VkDescriptorSetLayoutCreateInfo setInfo = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+    setInfo.bindingCount = bindings.size();
+    setInfo.pBindings = bindings.data();
+
+    if (m_vkd->vkCreateDescriptorSetLayout(m_device, &setInfo, nullptr, &pipe.setLayout) != VK_SUCCESS) {
+      why = "vkCreateDescriptorSetLayout failed";
+      return false;
+    }
+
+    VkPushConstantRange pushRange = { VK_SHADER_STAGE_ALL_GRAPHICS, 0u, 128u };
+
+    VkPipelineLayoutCreateInfo layoutInfo = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    layoutInfo.setLayoutCount = 1u;
+    layoutInfo.pSetLayouts = &pipe.setLayout;
+    layoutInfo.pushConstantRangeCount = 1u;
+    layoutInfo.pPushConstantRanges = &pushRange;
+
+    if (m_vkd->vkCreatePipelineLayout(m_device, &layoutInfo, nullptr, &pipe.layout) != VK_SUCCESS) {
+      why = "vkCreatePipelineLayout failed";
+      return false;
+    }
+
+    std::array<VkPipelineShaderStageCreateInfo, 3> stageInfos = { };
+    const std::array<std::pair<VkShaderStageFlagBits, VkShaderModule>, 3> mods = {{
+      { VK_SHADER_STAGE_VERTEX_BIT, pipe.vs },
+      { VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, pipe.tcs },
+      { VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, pipe.tes },
+    }};
+
+    for (size_t i = 0u; i < 3u; i++) {
+      stageInfos[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stageInfos[i].stage = mods[i].first;
+      stageInfos[i].module = mods[i].second;
+      stageInfos[i].pName = "main";
+    }
+
+    VkPipelineVertexInputStateCreateInfo viInfo = { VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    viInfo.vertexBindingDescriptionCount = rq.bindings.size();
+    viInfo.pVertexBindingDescriptions = rq.bindings.data();
+    viInfo.vertexAttributeDescriptionCount = rq.attributes.size();
+    viInfo.pVertexAttributeDescriptions = rq.attributes.data();
+
+    VkPipelineInputAssemblyStateCreateInfo iaInfo = { VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO };
+    iaInfo.topology = VK_PRIMITIVE_TOPOLOGY_PATCH_LIST;
+
+    VkPipelineTessellationStateCreateInfo tessInfo = { VK_STRUCTURE_TYPE_PIPELINE_TESSELLATION_STATE_CREATE_INFO };
+    tessInfo.patchControlPoints = rq.patchControlPoints;
+
+    VkViewport viewport = { 0.0f, 0.0f, 64.0f, 64.0f, 0.0f, 1.0f };
+    VkRect2D scissor = { { 0, 0 }, { 64u, 64u } };
+
+    VkPipelineViewportStateCreateInfo vpInfo = { VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+    vpInfo.viewportCount = 1u;
+    vpInfo.pViewports = &viewport;
+    vpInfo.scissorCount = 1u;
+    vpInfo.pScissors = &scissor;
+
+    VkPipelineRasterizationStateCreateInfo rsInfo = { VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO };
+    rsInfo.rasterizerDiscardEnable = VK_TRUE;
+    rsInfo.polygonMode = VK_POLYGON_MODE_FILL;
+    rsInfo.cullMode = VK_CULL_MODE_NONE;
+    rsInfo.lineWidth = 1.0f;
+
+    VkPipelineMultisampleStateCreateInfo msInfo = { VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+    msInfo.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+
+    VkPipelineRenderingCreateInfo renderInfo = { VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO };
+
+    VkGraphicsPipelineCreateInfo pipeInfo = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    pipeInfo.pNext = &renderInfo;
+    pipeInfo.stageCount = stageInfos.size();
+    pipeInfo.pStages = stageInfos.data();
+    pipeInfo.pVertexInputState = &viInfo;
+    pipeInfo.pInputAssemblyState = &iaInfo;
+    pipeInfo.pTessellationState = &tessInfo;
+    pipeInfo.pViewportState = &vpInfo;
+    pipeInfo.pRasterizationState = &rsInfo;
+    pipeInfo.pMultisampleState = &msInfo;
+    pipeInfo.layout = pipe.layout;
+
+    VkResult vr = m_vkd->vkCreateGraphicsPipelines(m_device, VK_NULL_HANDLE, 1u, &pipeInfo, nullptr, &pipe.pipeline);
+
+    if (vr != VK_SUCCESS) {
+      why = str::format("lavapipe vkCreateGraphicsPipelines failed: ", vr);
+      return false;
+    }
+
+    pipe.outLayout = layout;
+    return true;
+  }
+
+
+  DxvkTessEmu::Pipe* DxvkTessEmu::getPipe(const DxvkTessEmuRequest& rq, std::string& why) {
+    DxvkHashState hash;
+
+    for (const auto& a : rq.attributes) {
+      hash.add(a.location);
+      hash.add(a.binding);
+      hash.add(uint32_t(a.format));
+      hash.add(a.offset);
+    }
+
+    for (const auto& b : rq.bindings) {
+      hash.add(b.binding);
+      hash.add(b.stride);
+      hash.add(uint32_t(b.inputRate));
+    }
+
+    std::string key = str::format(
+      DxvkShader::getCookie(rq.vs), ":", DxvkShader::getCookie(rq.tcs), ":",
+      DxvkShader::getCookie(rq.tes), ":", rq.patchControlPoints, ":", size_t(hash),
+      ":", rq.tesLinkage.hash(), ":", rq.tcsLinkage.hash(), ":", rq.vsLinkage.hash());
+
+    auto entry = m_pipes.find(key);
+
+    if (entry != m_pipes.end()) {
+      if (!entry->second) {
+        why = "pipeline creation failed earlier";
+        return nullptr;
+      }
+
+      return entry->second.get();
+    }
+
+    auto pipe = std::make_unique<Pipe>();
+
+    if (!createPipe(*pipe, rq, why)) {
+      Logger::err(str::format("BVMTESS: cannot create lavapipe pipeline: ", why));
+      m_pipes.emplace(key, nullptr);
+      return nullptr;
+    }
+
+    Logger::warn(str::format("BVMTESS: created lavapipe pipeline ", key, " (", pipe->entries.size(),
+      " descriptors, stride ", pipe->outLayout->stride, ", ", pipe->outLayout->attributes.size(), " attributes)"));
+
+    Pipe* result = pipe.get();
+    m_pipes.emplace(key, std::move(pipe));
+    return result;
+  }
+
+
+  bool DxvkTessEmu::run(const DxvkTessEmuRequest& rq, DxvkTessEmuOutput& output, std::string& why) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+
+    if (!m_initialized) {
+      m_initialized = true;
+      m_ok = init();
+    }
+
+    if (!m_ok) {
+      why = "lavapipe device unavailable";
+      return false;
+    }
+
+    Pipe* pipe = getPipe(rq, why);
+
+    if (!pipe)
+      return false;
+
+    const auto& layout = *pipe->outLayout;
+
+    // --- Work out which vertex ranges the draw reads --------------------
+    struct Copy {
+      uint32_t binding;
+      size_t   srcOffset;
+      size_t   bytes;
+      VkDeviceSize dst;
+    };
+
+    std::vector<Copy> copies;
+    std::set<uint32_t> usedBindings;
+
+    for (const auto& a : rq.attributes)
+      usedBindings.insert(a.binding);
+
+    int32_t drawVertexOffset = 0;
+    uint32_t minIndex = 0u, maxIndex = 0u;
+    size_t indexBytes = 0u;
+    const uint8_t* indexSrc = nullptr;
+
+    if (rq.indexed) {
+      uint32_t isz = rq.indexType == VK_INDEX_TYPE_UINT16 ? 2u : (rq.indexType == VK_INDEX_TYPE_UINT32 ? 4u : 0u);
+
+      if (!isz) {
+        why = "unsupported index type";
+        return false;
+      }
+
+      indexBytes = size_t(rq.count) * isz;
+
+      if (!rq.indexData || (size_t(rq.first) + rq.count) * isz > rq.indexSize) {
+        why = "index buffer not CPU readable or out of range";
+        return false;
+      }
+
+      indexSrc = rq.indexData + size_t(rq.first) * isz;
+      minIndex = ~0u;
+      maxIndex = 0u;
+
+      for (uint32_t i = 0u; i < rq.count; i++) {
+        uint32_t idx = isz == 2u
+          ? reinterpret_cast<const uint16_t*>(indexSrc)[i]
+          : reinterpret_cast<const uint32_t*>(indexSrc)[i];
+
+        minIndex = std::min(minIndex, idx);
+        maxIndex = std::max(maxIndex, idx);
+      }
+    }
+
+    VkDeviceSize cursor = 256u;  // the first 256 bytes hold the XFB counter
+
+    for (const auto& b : rq.bindings) {
+      if (!usedBindings.count(b.binding))
+        continue;
+
+      const auto& vb = rq.vertexBuffers[b.binding];
+
+      uint64_t lo, cnt;
+
+      if (b.inputRate == VK_VERTEX_INPUT_RATE_INSTANCE) {
+        lo = rq.firstInstance;
+        cnt = 1u;
+      } else if (rq.indexed) {
+        int64_t first = int64_t(minIndex) + rq.vertexOffset;
+
+        if (first < 0) {
+          why = "negative vertex index";
+          return false;
+        }
+
+        lo = uint64_t(first);
+        cnt = uint64_t(maxIndex) - minIndex + 1u;
+      } else {
+        lo = rq.first;
+        cnt = rq.count;
+      }
+
+      if (!vb.data || (lo + cnt) * b.stride > vb.size) {
+        why = str::format("vertex buffer ", b.binding, " not CPU readable or out of range");
+        return false;
+      }
+
+      cursor = alignUp(cursor, 16u);
+      copies.push_back({ b.binding, size_t(lo * b.stride), size_t(cnt * b.stride), cursor });
+      cursor += cnt * b.stride;
+
+      if (rq.indexed && b.inputRate == VK_VERTEX_INPUT_RATE_VERTEX)
+        drawVertexOffset = rq.vertexOffset - int32_t(lo);
+    }
+
+    VkDeviceSize indexDst = 0u;
+
+    if (rq.indexed) {
+      cursor = alignUp(cursor, 16u);
+      indexDst = cursor;
+      cursor += indexBytes;
+    }
+
+    // Resources
+    struct ResCopy {
+      const uint8_t* data;
+      size_t size;
+      VkDeviceSize dst;
+    };
+
+    std::vector<ResCopy> resCopies;
+
+    for (const auto& e : pipe->entries) {
+      const uint8_t* data = nullptr;
+      size_t size = 0u;
+
+      if (!rq.resolver || !rq.resolver(e.stage, e.desc, data, size) || !data || !size) {
+        why = str::format("cannot read resource (stage ", uint32_t(e.stage), ", set ", e.desc.getSet(),
+          ", binding ", e.desc.getBinding(), ", index ", e.desc.getResourceIndex(), ")");
+        return false;
+      }
+
+      if (size > (16u << 20u)) {
+        why = "resource too large";
+        return false;
+      }
+
+      cursor = alignUp(cursor, m_uboAlign);
+      resCopies.push_back({ data, size, cursor });
+      cursor += alignUp(size, 16u);
+    }
+
+    // Transform feedback output
+    uint32_t patches = std::max(1u, rq.count / std::max(1u, rq.patchControlPoints));
+    VkDeviceSize xfbCapacity = std::clamp<VkDeviceSize>(
+      VkDeviceSize(patches) * layout.stride * 400u, 256u << 10u, 32u << 20u);
+
+    for (uint32_t attempt = 0u; attempt < 4u; attempt++) {
+      VkDeviceSize xfbOffset = alignUp(cursor, 256u);
+      VkDeviceSize total = xfbOffset + xfbCapacity;
+
+      if (!ensureBuffer(total, why))
+        return false;
+
+      uint8_t* map = m_bufferMap;
+      std::memset(map, 0, 256u);
+
+      for (const auto& c : copies) {
+        const auto& vb = rq.vertexBuffers[c.binding];
+        std::memcpy(map + c.dst, vb.data + c.srcOffset, c.bytes);
+      }
+
+      if (rq.indexed)
+        std::memcpy(map + indexDst, indexSrc, indexBytes);
+
+      for (const auto& r : resCopies)
+        std::memcpy(map + r.dst, r.data, r.size);
+
+      // Descriptors
+      m_vkd->vkResetDescriptorPool(m_device, m_descPool, 0u);
+
+      VkDescriptorSet set = VK_NULL_HANDLE;
+
+      VkDescriptorSetAllocateInfo setAlloc = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+      setAlloc.descriptorPool = m_descPool;
+      setAlloc.descriptorSetCount = 1u;
+      setAlloc.pSetLayouts = &pipe->setLayout;
+
+      if (m_vkd->vkAllocateDescriptorSets(m_device, &setAlloc, &set) != VK_SUCCESS) {
+        why = "vkAllocateDescriptorSets failed";
+        return false;
+      }
+
+      std::vector<VkDescriptorBufferInfo> bufInfos(pipe->entries.size());
+      std::vector<VkWriteDescriptorSet> writes(pipe->entries.size());
+
+      for (size_t i = 0u; i < pipe->entries.size(); i++) {
+        bufInfos[i] = { m_buffer, resCopies[i].dst, alignUp(resCopies[i].size, 16u) };
+
+        writes[i] = { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        writes[i].dstSet = set;
+        writes[i].dstBinding = pipe->entries[i].binding;
+        writes[i].descriptorCount = 1u;
+        writes[i].descriptorType = pipe->entries[i].type;
+        writes[i].pBufferInfo = &bufInfos[i];
+      }
+
+      if (!writes.empty())
+        m_vkd->vkUpdateDescriptorSets(m_device, writes.size(), writes.data(), 0u, nullptr);
+
+      // Record
+      m_vkd->vkResetCommandBuffer(m_cmd, 0u);
+
+      VkCommandBufferBeginInfo beginInfo = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+      beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      m_vkd->vkBeginCommandBuffer(m_cmd, &beginInfo);
+
+      VkRenderingInfo renderInfo = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+      renderInfo.renderArea = { { 0, 0 }, { 64u, 64u } };
+      renderInfo.layerCount = 1u;
+
+      m_vkd->vkCmdBeginRendering(m_cmd, &renderInfo);
+      m_vkd->vkCmdBindPipeline(m_cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe->pipeline);
+
+      std::array<uint32_t, 32> push = { };
+      push[0] = rq.builtIns;
+      m_vkd->vkCmdPushConstants(m_cmd, pipe->layout, VK_SHADER_STAGE_ALL_GRAPHICS, 0u, 128u, push.data());
+
+      m_vkd->vkCmdBindDescriptorSets(m_cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe->layout, 0u, 1u, &set, 0u, nullptr);
+
+      for (const auto& c : copies) {
+        VkDeviceSize offset = c.dst;
+        m_vkd->vkCmdBindVertexBuffers(m_cmd, c.binding, 1u, &m_buffer, &offset);
+      }
+
+      if (rq.indexed)
+        m_vkd->vkCmdBindIndexBuffer(m_cmd, m_buffer, indexDst, rq.indexType);
+
+      VkDeviceSize xfbOff = xfbOffset;
+      VkDeviceSize xfbSize = xfbCapacity;
+      m_vkd->vkCmdBindTransformFeedbackBuffersEXT(m_cmd, 0u, 1u, &m_buffer, &xfbOff, &xfbSize);
+      m_vkd->vkCmdBeginTransformFeedbackEXT(m_cmd, 0u, 0u, nullptr, nullptr);
+
+      if (rq.indexed)
+        m_vkd->vkCmdDrawIndexed(m_cmd, rq.count, 1u, 0u, drawVertexOffset, 0u);
+      else
+        m_vkd->vkCmdDraw(m_cmd, rq.count, 1u, 0u, 0u);
+
+      VkDeviceSize counterOff = 0u;
+      m_vkd->vkCmdEndTransformFeedbackEXT(m_cmd, 0u, 1u, &m_buffer, &counterOff);
+      m_vkd->vkCmdEndRendering(m_cmd);
+      m_vkd->vkEndCommandBuffer(m_cmd);
+
+      VkSubmitInfo submit = { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+      submit.commandBufferCount = 1u;
+      submit.pCommandBuffers = &m_cmd;
+
+      if (m_vkd->vkQueueSubmit(m_queue, 1u, &submit, VK_NULL_HANDLE) != VK_SUCCESS
+       || m_vkd->vkQueueWaitIdle(m_queue) != VK_SUCCESS) {
+        why = "lavapipe submit failed";
+        return false;
+      }
+
+      uint32_t bytes;
+      std::memcpy(&bytes, map, sizeof(bytes));
+
+      if (VkDeviceSize(bytes) + 3u * layout.stride >= xfbCapacity) {
+        // Possibly truncated, retry with more room
+        xfbCapacity *= 4u;
+
+        if (xfbCapacity > (128u << 20u)) {
+          why = "tessellation output too large";
+          return false;
+        }
+
+        continue;
+      }
+
+      uint32_t vertices = bytes / layout.stride;
+      vertices -= vertices % 3u;
+
+      if (layout.topology == VK_PRIMITIVE_TOPOLOGY_LINE_LIST)
+        vertices &= ~1u;
+
+      output.layout = pipe->outLayout;
+      output.vertexCount = vertices;
+      output.vertices.assign(map + xfbOffset, map + xfbOffset + size_t(vertices) * layout.stride);
+      return true;
+    }
+
+    why = "tessellation output too large";
+    return false;
+  }
+
+}
diff --git a/src/dxvk/dxvk_tessemu.h b/src/dxvk/dxvk_tessemu.h
new file mode 100644
index 00000000..11212978
--- /dev/null
+++ b/src/dxvk/dxvk_tessemu.h
@@ -0,0 +1,192 @@
+#pragma once
+
+// BVM-GPU: tessellation emulation for devices without tessellationShader (V3D).
+//
+// The tessellation stages (VS + HS + fixed-function tessellator + DS) of a draw
+// are executed on lavapipe (llvmpipe) with rasterizer discard, and the tessellated
+// triangles are captured with VK_EXT_transform_feedback. The caller then draws the
+// captured vertices on the real device with a generated pass-through vertex shader
+// and the application's own fragment shader.
+//
+// See ~/bvm-gpu/README.md (item 51) and ~/bvm-gpu/tessemu-test/ for the standalone
+// feasibility test this is based on.
+
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "dxvk_graphics.h"
+#include "dxvk_pipelayout.h"
+#include "dxvk_shader.h"
+
+#include "../vulkan/vulkan_loader.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Resolves a shader descriptor to CPU-readable data
+   *
+   * \param [in] stage Shader stage that declares the descriptor
+   * \param [in] desc Descriptor metadata
+   * \param [out] data Pointer to the first byte of the bound range
+   * \param [out] size Size of the bound range, in bytes
+   * \returns \c true if the resource could be resolved
+   */
+  using DxvkTessEmuResolver = std::function<bool(
+    VkShaderStageFlagBits stage, const DxvkShaderDescriptor& desc,
+    const uint8_t*& data, size_t& size)>;
+
+  /**
+   * \brief Tessellated draw request
+   */
+  struct DxvkTessEmuRequest {
+    Rc<DxvkShader> vs;
+    Rc<DxvkShader> tcs;
+    Rc<DxvkShader> tes;
+
+    DxvkShaderLinkage vsLinkage;
+    DxvkShaderLinkage tcsLinkage;
+    DxvkShaderLinkage tesLinkage;
+
+    uint32_t patchControlPoints = 0u;
+
+    /// Vertex input layout (strides filled in)
+    std::vector<VkVertexInputAttributeDescription> attributes;
+    std::vector<VkVertexInputBindingDescription> bindings;
+
+    /// CPU-readable vertex buffer contents, by binding
+    struct VertexBuffer {
+      const uint8_t* data = nullptr;
+      size_t size = 0u;
+    };
+
+    std::array<VertexBuffer, 32> vertexBuffers = { };
+
+    /// Draw parameters. For indexed draws, \c count is the index count and
+    /// \c first is the first index; otherwise vertex count and first vertex.
+    bool indexed = false;
+    VkIndexType indexType = VK_INDEX_TYPE_UINT32;
+    const uint8_t* indexData = nullptr;
+    size_t indexSize = 0u;
+    uint32_t count = 0u;
+    uint32_t first = 0u;
+    int32_t vertexOffset = 0;
+    uint32_t firstInstance = 0u;
+
+    /// Shared push data word that holds the built-ins
+    uint32_t builtIns = 0u;
+
+    DxvkTessEmuResolver resolver;
+  };
+
+
+  /**
+   * \brief Layout of the captured vertices and the pass-through shader
+   */
+  struct DxvkTessEmuLayout {
+    struct Attribute {
+      uint32_t location;
+      VkFormat format;
+      uint32_t offset;
+    };
+
+    uint32_t stride = 0u;
+    VkPrimitiveTopology topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    std::vector<Attribute> attributes;
+    Rc<DxvkShader> passthroughVs;
+  };
+
+
+  /**
+   * \brief Tessellated vertices captured from lavapipe
+   */
+  struct DxvkTessEmuOutput {
+    std::shared_ptr<const DxvkTessEmuLayout> layout;
+    std::vector<uint8_t> vertices;
+    uint32_t vertexCount = 0u;
+  };
+
+
+  /**
+   * \brief Tessellation emulator, backed by a lavapipe device
+   */
+  class DxvkTessEmu {
+
+  public:
+
+    static DxvkTessEmu& get();
+
+    /**
+     * \brief Runs the tessellation stages for one draw
+     *
+     * \param [in] request Draw request
+     * \param [out] output Captured vertices
+     * \param [out] why Failure reason if the call returns \c false
+     * \returns \c true on success
+     */
+    bool run(const DxvkTessEmuRequest& request, DxvkTessEmuOutput& output, std::string& why);
+
+  private:
+
+    struct BindingEntry {
+      VkShaderStageFlagBits stage;
+      DxvkShaderDescriptor  desc;
+      VkDescriptorType      type;
+      uint32_t              binding;
+    };
+
+    struct Pipe {
+      VkShaderModule        vs = VK_NULL_HANDLE;
+      VkShaderModule        tcs = VK_NULL_HANDLE;
+      VkShaderModule        tes = VK_NULL_HANDLE;
+      VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+      VkPipelineLayout      layout = VK_NULL_HANDLE;
+      VkPipeline            pipeline = VK_NULL_HANDLE;
+      std::vector<BindingEntry> entries;
+      std::shared_ptr<const DxvkTessEmuLayout> outLayout;
+    };
+
+    DxvkTessEmu();
+
+    bool init();
+
+    Pipe* getPipe(const DxvkTessEmuRequest& rq, std::string& why);
+
+    bool createPipe(Pipe& pipe, const DxvkTessEmuRequest& rq, std::string& why);
+
+    bool ensureBuffer(VkDeviceSize size, std::string& why);
+
+    std::mutex            m_mutex;
+    bool                  m_initialized = false;
+    bool                  m_ok = false;
+    bool                  m_loggedFail = false;
+
+    Rc<vk::LibraryFn>     m_vkl;
+    Rc<vk::InstanceFn>    m_vki;
+    Rc<vk::DeviceFn>      m_vkd;
+
+    VkInstance            m_instance = VK_NULL_HANDLE;
+    VkPhysicalDevice      m_physical = VK_NULL_HANDLE;
+    VkDevice              m_device = VK_NULL_HANDLE;
+    VkQueue               m_queue = VK_NULL_HANDLE;
+    uint32_t              m_queueFamily = 0u;
+    VkPhysicalDeviceMemoryProperties m_memory = { };
+    VkDeviceSize          m_uboAlign = 256u;
+
+    VkCommandPool         m_cmdPool = VK_NULL_HANDLE;
+    VkCommandBuffer       m_cmd = VK_NULL_HANDLE;
+    VkDescriptorPool      m_descPool = VK_NULL_HANDLE;
+
+    VkBuffer              m_buffer = VK_NULL_HANDLE;
+    VkDeviceMemory        m_bufferMem = VK_NULL_HANDLE;
+    VkDeviceSize          m_bufferSize = 0u;
+    uint8_t*              m_bufferMap = nullptr;
+
+    std::unordered_map<std::string, std::unique_ptr<Pipe>> m_pipes;
+
+  };
+
+}
