+  static bool bvmIgnoreDiscard(bool color) {
+    static const bool keep = bvmEnvFlag("BVM_DXVK_KEEPDISCARD");
+    static const bool all  = bvmEnvFlag("BVM_DXVK_NODISCARD");
+    return !keep && (color || all);
+  }
