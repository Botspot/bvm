+
+// BVMDIAG: draws skipped because the pipeline failed to compile (tessellation
+// on V3D). Prints a per-5-second summary when BVM_DXVK_PASSLOG=1.
+static void bvmNoteSkippedDraw() {
+  if (!bvmPassLogEnabled())
+    return;
+
+  static std::atomic<uint32_t> count = { 0u };
+  static std::atomic<unsigned long long> lastUs = { 0ull };
+
+  count.fetch_add(1u);
+
+  unsigned long long now = bvmNowUs();
+  unsigned long long last = lastUs.load();
+
+  if (!last) {
+    lastUs.compare_exchange_strong(last, now);
+  } else if (now - last >= 5000000ull && lastUs.compare_exchange_strong(last, now)) {
+    fprintf(stderr, "BVMSKIP t_us=%llu pid=%d skipped_draws_last_5s=%u\n",
+      now, (int)getpid(), count.exchange(0u));
+  }
+}
