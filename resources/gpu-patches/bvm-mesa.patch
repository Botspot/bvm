+ * src = ONE, dst = ONE_MINUS_SRC1_ALPHA, ADD for colour and alpha, i.e.
+ * result = out0 + dst * (1 - out1.a). V3D has no dual-source blending. */
+bool
+v3dv_dual_src_coverage_blend(const VkPipelineColorBlendAttachmentState *s)
+{
+   return s->blendEnable &&
+          s->srcColorBlendFactor == VK_BLEND_FACTOR_ONE &&
+          s->dstColorBlendFactor == VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA &&
+          s->colorBlendOp == VK_BLEND_OP_ADD &&
+          s->srcAlphaBlendFactor == VK_BLEND_FACTOR_ONE &&
