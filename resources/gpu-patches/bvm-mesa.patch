+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *i = nir_instr_as_intrinsic(instr);
+         if (i->intrinsic != nir_intrinsic_store_deref)
+            continue;
+         nir_deref_instr *d = nir_src_as_deref(i->src[0]);
+         if (d->deref_type != nir_deref_type_var)
+            continue;
+         if (d->var == v0) { st0 = i; n0++; }
+         else if (d->var == v1) { st1 = i; n1++; }
+      }
+   }
