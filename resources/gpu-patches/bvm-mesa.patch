+      exec_node_remove(&v1->node);
+      nir_metadata_preserve(impl, nir_metadata_control_flow);
+      return;
+   }
+
+   if (v0 && glsl_get_vector_elements(v0->type) == 4 && n0 == 1 && n1 == 1 &&
+       st0->src[1].ssa->bit_size == 32 && st1->src[1].ssa->bit_size == 32 &&
+       st0->instr.block == st1->instr.block) {
+      /* Make sure the output 0 store comes last so both values are available */
+      nir_index_instrs(impl);
+      if (st0->instr.index < st1->instr.index)
+         nir_instr_move(nir_after_instr(&st1->instr), &st0->instr);
+
+      nir_builder b = nir_builder_at(nir_before_instr(&st0->instr));
+      nir_def *val0 = st0->src[1].ssa;
+      nir_def *val1 = st1->src[1].ssa;
