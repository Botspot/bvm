+      nir_builder b = nir_builder_at(nir_before_instr(&st0->instr));
+      nir_def *val0 = st0->src[1].ssa;
+      nir_def *cov = nir_channel(&b, st1->src[1].ssa, 3);
+      nir_def *inv = nir_fadd_imm(&b, nir_fneg(&b, cov), 1.0f);
