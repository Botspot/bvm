+            nir_deref_instr *d = nir_src_as_deref(i->src[0]);
+            if (d->deref_type == nir_deref_type_var && d->var == v1)
+               nir_instr_remove(instr);
+         }
+      }
+   }
+
+   exec_node_remove(&v1->node);
+   nir_metadata_preserve(impl, nir_metadata_control_flow);
+}
