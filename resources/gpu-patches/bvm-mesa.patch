+       glsl_get_vector_elements(v1->type) == 4 && n0 == 1 && n1 == 1 &&
+       st0->src[1].ssa->bit_size == 32 && st1->src[1].ssa->bit_size == 32 &&
+       st0->src[1].ssa->num_components == 4 && st1->src[1].ssa->num_components == 4 &&
+       st0->instr.block == st1->instr.block) {
