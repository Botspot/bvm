+      unsigned cnt = MIN2(val1->num_components, 3u);
+      nir_def *sum = nir_channel(&b, val1, 0);
+      for (unsigned i = 1; i < cnt; i++)
+         sum = nir_fadd(&b, sum, nir_channel(&b, val1, i));
+      c[3] = nir_fmul_imm(&b, sum, 1.0f / cnt);
