@@ -934,9 +934,11 @@ void SpirvBuilder::emitDclBuiltInIoVar(const ir::Op& op) {
           ? spv::BuiltInFragCoord : spv::BuiltInPosition;
 
       case ir::BuiltIn::eVertexId: {
