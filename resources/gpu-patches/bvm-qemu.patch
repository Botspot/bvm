+/*
+ * BVMGPU: the audio pump (audio_timer: device callback -> backend ring buffer) normally runs on the
+ * main loop, so a busy or starved main thread (display blits, swapping, guest CPU load) makes it late,
+ * the backend runs dry and the speakers crackle. Run the timer in its own IOThread instead, which can
+ * be given a low nice value like PipeWire's own threads. The device callbacks still need the BQL, so
+ * the thread takes it around the pump: the gain is that the wake-up is no longer queued behind the main
+ * loop's other work.
+ *
+ * The pump thread and the PipeWire backend's thread get nice -11. A plain user may only lower nice if
+ * in the 'pipewire' group (limits.d: nice -19); otherwise a warning is printed and nothing changes.
+ */
+void bvm_audio_set_thread_priority(const char *what, pid_t tid)
+{
+#ifdef CONFIG_LINUX
+    const int nice_val = -11;
+
+    if (setpriority(PRIO_PROCESS, tid, nice_val) == 0) {
+        info_report("audio: %s thread nice set to %d", what, nice_val);
+    } else {
+        warn_report("audio: cannot set nice %d on the %s thread: %s (add the user to the 'pipewire' "
+                    "group to allow it)", nice_val, what, strerror(errno));
+    }
+#endif
+}
+
+static IOThread *audio_pump_iothread;
+
+static void audio_timer_iothread(void *opaque)
+{
+    /*
+     * Do not block in bql_lock(): when the VM is being stopped (shutdown, Ctrl+C, window close) the main
+     * thread holds the BQL in pause_all_vcpus() -> qemu_clock_enable(QEMU_CLOCK_VIRTUAL, false), which waits
+     * for this callback to return. Poll the lock and give up once the VM is no longer running (the timer is
+     * re-armed by audio_vm_change_state_handler() on resume).
+     */
+    for (int spins = 0; !bvm_bql_trylock(); spins++) {
+        if (!runstate_is_running()) {
+            return;
+        }
+        if (spins >= 50) {
+            g_usleep(100);
+        }
+    }
+    audio_timer(opaque);
+    bql_unlock();
+}
+
+static AioContext *audio_pump_context(void)
+{
+    Error *err = NULL;
+
+    if (!audio_pump_iothread) {
+        audio_pump_iothread = iothread_create("bvm-audio", &err);
+        if (!audio_pump_iothread) {
+            warn_report_err(err);
+            return NULL;
+        }
+        bvm_audio_set_thread_priority("pump", audio_pump_iothread->thread_id);
+    }
+    return iothread_get_aio_context(audio_pump_iothread);
+}
