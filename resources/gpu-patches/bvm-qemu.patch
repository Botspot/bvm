+ * no wl_shm upload as with GtkGLArea. The guest dmabuf is imported as a GL
+ * texture on SDL's own EGL display and blitted into the window.
+ *
+ * No fence is created for the guest dmabuf (guest_fb.dmabuf stays NULL): like
+ * BVM_GL_NOBLOCK this relies on the kernel's implicit dmabuf synchronisation
+ * between the blit (reader) and the guest's next render (writer).
+ */
+static bool sdl2_gl_egl_display_init(struct sdl2_console *scon)
+{
+    if (!scon->real_window || !scon->winctx) {
+        return false;
+    }
