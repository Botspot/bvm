+/*
+ * BVMGPU: raise the priority of the threads PipeWire created for us. pw_loop_invoke() into the thread
+ * loop trips its lock accounting ("this->recurse > 0 failed in do_unlock"), so find the threads by
+ * name instead: "PipeWire thread loop" (comm is cut to 15 chars) and PipeWire's data loop thread.
+ */
+static void bvm_pw_raise_thread_priorities(void)
+{
+#ifdef CONFIG_LINUX
+    GDir *dir = g_dir_open("/proc/self/task", 0, NULL);
+    const char *name;
+
+    while (dir && (name = g_dir_read_name(dir))) {
+        g_autofree char *path = g_strdup_printf("/proc/self/task/%s/comm", name);
+        g_autofree char *comm = NULL;
+
+        if (g_file_get_contents(path, &comm, NULL, NULL) &&
+            (g_str_has_prefix(comm, "PipeWire thread") ||
+             g_str_has_prefix(comm, "data-loop"))) {
+            bvm_audio_set_thread_priority("PipeWire", atoi(name));
+        }
+    }
+    if (dir) {
+        g_dir_close(dir);
+    }
+#endif
+}
