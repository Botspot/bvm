+/*
+ * BVMGPU: non-blocking BQL acquire for the audio pump IOThread. pause_all_vcpus() (shutdown, 'stop')
+ * disables QEMU_CLOCK_VIRTUAL and waits for running timer callbacks while holding the BQL, so a timer
+ * callback that blocks in bql_lock() deadlocks it (QEMU would not exit on Ctrl+C / window close).
+ */
+bool bvm_bql_trylock(void)
+{
+    g_assert(!bql_locked());
+    if (qemu_mutex_trylock(&bql)) {
+        return false;
+    }
+    set_bql_locked(true);
+    return true;
+}
