diff --git a/ui/sdl2-clipboard.c b/ui/sdl2-clipboard.c
new file mode 100644
index 0000000..9e3fce8
--- /dev/null
+++ b/ui/sdl2-clipboard.c
@@ -0,0 +1,106 @@
+/*
+ * SDL2 UI -- clipboard support (BVMGPU)
+ *
+ * The SDL2 display had no clipboard code, so the SPICE agent's clipboard (qemu-vdagent
+ * chardev, clipboard=on) did nothing with -display sdl. This is a text-only peer modelled on
+ * gtk-clipboard.c. SDL has no lazy "provide data on paste" API, so guest->host copies the
+ * text eagerly as soon as the guest announces it; host->guest announces on SDL_CLIPBOARDUPDATE
+ * and reads the text when the guest asks for it.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "ui/console.h"
+#include "ui/clipboard.h"
+#include "ui/sdl2.h"
+
+static QemuClipboardPeer sdl2_cbpeer;
+static char *sdl2_cb_last_set;  /* text we put into the host clipboard ourselves */
+
+static void sdl2_clipboard_update_info(QemuClipboardInfo *info)
+{
+    QemuClipboardSelection s = info->selection;
+    QemuClipboardInfo *cur = qemu_clipboard_info(s);
+
+    if (s != QEMU_CLIPBOARD_SELECTION_CLIPBOARD || info->owner == &sdl2_cbpeer) {
+        return;
+    }
+
+    if (info != cur) {
+        /* the guest grabbed the clipboard: fetch the text right away */
+        if (info->types[QEMU_CLIPBOARD_TYPE_TEXT].available &&
+            !info->types[QEMU_CLIPBOARD_TYPE_TEXT].data) {
+            qemu_clipboard_request(info, QEMU_CLIPBOARD_TYPE_TEXT);
+        }
+        return;
+    }
+
+    /* data for the current info arrived */
+    if (info->types[QEMU_CLIPBOARD_TYPE_TEXT].data) {
+        char *text = g_strndup(info->types[QEMU_CLIPBOARD_TYPE_TEXT].data,
+                               info->types[QEMU_CLIPBOARD_TYPE_TEXT].size);
+
+        g_free(sdl2_cb_last_set);
+        sdl2_cb_last_set = text;
+        SDL_SetClipboardText(text);
+    }
+}
+
+static void sdl2_clipboard_notify(Notifier *notifier, void *data)
+{
+    QemuClipboardNotify *notify = data;
+
+    if (notify->type == QEMU_CLIPBOARD_UPDATE_INFO) {
+        sdl2_clipboard_update_info(notify->info);
+    }
+}
+
+static void sdl2_clipboard_request(QemuClipboardInfo *info,
+                                   QemuClipboardType type)
+{
+    char *text;
+
+    if (type != QEMU_CLIPBOARD_TYPE_TEXT) {
+        return;
+    }
+    text = SDL_GetClipboardText();
+    if (text && text[0]) {
+        qemu_clipboard_set_data(&sdl2_cbpeer, info, type, strlen(text), text, true);
+    }
+    SDL_free(text);
+}
+
+/* SDL_CLIPBOARDUPDATE: the host clipboard changed (also fires for our own SDL_SetClipboardText) */
+void sdl2_clipboard_changed(void)
+{
+    QemuClipboardInfo *info;
+    char *text;
+
+    if (!SDL_HasClipboardText()) {
+        return;
+    }
+    text = SDL_GetClipboardText();
+    if (!text || !text[0] ||
+        (sdl2_cb_last_set && !strcmp(text, sdl2_cb_last_set))) {
+        SDL_free(text);
+        return;
+    }
+    SDL_free(text);
+
+    info = qemu_clipboard_info_new(&sdl2_cbpeer, QEMU_CLIPBOARD_SELECTION_CLIPBOARD);
+    info->types[QEMU_CLIPBOARD_TYPE_TEXT].available = true;
+    qemu_clipboard_update(info);
+    qemu_clipboard_info_unref(info);
+}
+
+void sdl2_clipboard_init(void)
+{
+    sdl2_cbpeer.name = "sdl2";
+    sdl2_cbpeer.notifier.notify = sdl2_clipboard_notify;
+    sdl2_cbpeer.request = sdl2_clipboard_request;
