+/* BVM workaround (README item 120): true if a texture sample sits inside a loop. */
+static bool
+bvm_cf_list_has_tex_in_loop(struct exec_list *list, bool in_loop)
+{
+        foreach_list_typed(nir_cf_node, node, node, list) {
+                switch (node->type) {
+                case nir_cf_node_block:
+                        if (in_loop) {
+                                nir_foreach_instr(instr, nir_cf_node_as_block(node)) {
+                                        if (instr->type == nir_instr_type_tex)
+                                                return true;
+                                }
+                        }
+                        break;
+                case nir_cf_node_if: {
+                        nir_if *nif = nir_cf_node_as_if(node);
+                        if (bvm_cf_list_has_tex_in_loop(&nif->then_list, in_loop) ||
+                            bvm_cf_list_has_tex_in_loop(&nif->else_list, in_loop))
+                                return true;
+                        break;
+                }
+                case nir_cf_node_loop:
+                        if (bvm_cf_list_has_tex_in_loop(&nir_cf_node_as_loop(node)->body, true))
+                                return true;
+                        break;
+                default:
+                        break;
+                }
+        }
+        return false;
+}
+
+static bool
+bvm_shader_has_tex_in_loop(nir_shader *s)
+{
+        nir_foreach_function_impl(impl, s) {
+                if (bvm_cf_list_has_tex_in_loop(&impl->body, false))
+                        return true;
+        }
+        return false;
+}
