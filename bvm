              run_in_terminal "export fullscreen=$fullscreen ; ${DIRECTORY}/bvm gpu-setup '$vmdir' && { [ \"\$(cat '$vmdir/gpu/state' 2>/dev/null)\" == transitioned ] || ${DIRECTORY}/bvm gpu-firstboot '$vmdir' ; } && ${DIRECTORY}/bvm boot-gpu '$vmdir' ; step_complete"
              ;;
